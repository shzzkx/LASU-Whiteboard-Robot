// define variable for remote controller enable/disable
bool RemoteControlCodeEnabled = true;


#include "iq_cpp.h"
using namespace vex;

bool penIsDown = false;

void penDown() {
  if (!penIsDown) {
    penMotor.spinFor(reverse, 90, degrees);
    penIsDown = true;
  }
}


void penUp() {
  if (penIsDown) {
    penMotor.spinFor(forward, 90, degrees);
    penIsDown = false;
  }
}

/* Controls
 F Down (press): pen down (90 degrees clockwise)
 F Up   (press): pen up (90 degrees anticlockwise)
 L Up   (hold): raise left motor speed
 L Down (hold): lower left motor speed
 R Up   (hold): raise right motor speed
 R Down (hold): lower right motor speed
 E Up   (hold): spin both motors forward
 E Down (hold): spin both motors in reverse
  Release E:     motors stop and hold position
*/

int main() {
 
  vexcodeInit();
  

  double vLeft = 30;
  double vRight = 30;
  const double step = 1;   // percent changed per loop while a button is held

  // Holds position when stopped.
  leftMotor.setStopping(hold);
  rightMotor.setStopping(hold);
  penMotor.setStopping(hold);  

  for (;;) {
    // Pen up or down
    if (Controller.ButtonFDown.pressing()) {
      penDown();
    }
    if (Controller.ButtonFUp.pressing()) {
      penUp();
    }

    // Left motor speed
    if (Controller.ButtonLUp.pressing()) {
      vLeft = fmin(vLeft + step, 100);
    }
    if (Controller.ButtonLDown.pressing()) {
      vLeft = fmax(vLeft - step, -100);
    }

    // Right motor speed
    if (Controller.ButtonRUp.pressing()) {
      vRight = fmin(vRight + step, 100);
    }
    if (Controller.ButtonRDown.pressing()) {
      vRight = fmax(vRight - step, -100);
    }

    // Drive
    if (Controller.ButtonEUp.pressing()) {
      leftMotor.spin(forward, vLeft, percent);
      rightMotor.spin(forward, vRight, percent);
    } else if (Controller.ButtonEDown.pressing()) {
      leftMotor.spin(reverse, vLeft, percent);
      rightMotor.spin(reverse, vRight, percent);
    } else {
      leftMotor.stop();
      rightMotor.stop();
    }

    // current speeds on brain screen
    Brain.Screen.clearLine(1);
    Brain.Screen.setCursor(1, 1);
    Brain.Screen.print("L %.0f  R %.0f", vLeft, vRight);
    if (Brain.buttonCheck.pressing()) {
      Brain.programStop();
    }

    wait(50, msec);

    if (Brain.buttonCheck.pressing())
      Brain.programStop();
  }
}
