void setVelocity(double t, double &v1)
{
  v1 = v1+t;
  wait(1,seconds);
}

int main() {
  // Initializing Robot Configuration. DO NOT REMOVE!
  vexcodeInit();
  // Begin project code
  double vLeft=30;
  double vRight=30;
  timer time1;
  double t = 0;
  Brain.Screen.setCursor(1,1);
  Brain.Screen.print("%f %f",vLeft,vRight);


     for(;;){
if(Controller.ButtonLDown.pressing()){
      time1.time(seconds);
      while(Controller.ButtonLDown.pressing()){
        t = time1.time(seconds);
        setVelocity(-t,vLeft);
        Brain.Screen.clearScreen();
          Brain.Screen.setCursor(1,1);
  Brain.Screen.print(" %f %f",vLeft,vRight);
      }
    }else if(Controller.ButtonRDown.pressing()){
       time1.time(seconds);
      while(Controller.ButtonRDown.pressing()){
        t = time1;
        setVelocity(-t,vRight);
        Brain.Screen.clearScreen();
          Brain.Screen.setCursor(1,1);
  Brain.Screen.print("%f %f",vLeft,vRight);
      }
    }
    if(Controller.ButtonFUp.pressing()){
      time1.time(seconds);
      while(Controller.ButtonFUp.pressing()){
        t = time1.time(seconds);
        setVelocity(t,vLeft);
        Brain.Screen.clearScreen();
          Brain.Screen.setCursor(1,1);
  Brain.Screen.print(" %f %f",vLeft,vRight);
      }
    }else if(Controller.ButtonFDown.pressing()){
       time1.time(seconds);
      while(Controller.ButtonFDown.pressing()){
        t = time1;
        setVelocity(t,vRight);
        Brain.Screen.clearScreen();
          Brain.Screen.setCursor(1,1);
  Brain.Screen.print("%f %f",vLeft,vRight);
      }
    }
    if(Controller.ButtonEUp.pressing()){
      leftMotor.spin(forward, vLeft, percent);
      rightMotor.spin(forward, vRight, percent);
      while(Controller.ButtonEUp.pressing()){}
      leftMotor.stop();
      rightMotor.stop();
    }else if(Controller.ButtonEDown.pressing()){
      leftMotor.spin(reverse, vLeft, percent);
      rightMotor.spin(reverse, vRight, percent);
      while(Controller.ButtonEDown.pressing()){}
      leftMotor.stop();
      rightMotor.stop();
    }
  }
  
  
}
